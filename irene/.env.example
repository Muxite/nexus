# Copy to `.env` beside `docker-compose.yml`.
#
# 1) Compose interpolates `${...}` in `docker-compose.yml` from this file (and your
#    shell). Example: published host port for the monitor (default 18080 if unset).
# IRENE_MONITOR_HOST_PORT=18080
#
# 2) The same file is passed into containers via `env_file` for app secrets — do not
#    list secrets under `environment:` in `docker-compose.yml`.
#
# Keys override `config.yaml` via `IRENE__<section>__<key>` (see
# `shared/irene_shared/config.py`). Keep non-secret settings in `config.yaml` only.
#
# Multiple keys per service (comma-separated); rate limits apply per key, with rotation.
# IRENE__SIGNALS__NEWSAPI_KEYS=
# IRENE__SIGNALS__BRAVE_API_KEYS=
# Legacy single-key names still work:
# IRENE__SIGNALS__NEWSAPI_KEY=
# IRENE__SIGNALS__BRAVE_API_KEY=
# GEMINI_API_KEY=

# Optional: higher Hugging Face Hub rate limits when scanner/feeder download models
# HF_TOKEN=

# Google Gemini API key — used for AI direction classification (Gemini Flash).
# Required when signals.use_llm_direction=true in config.yaml.
# Either form works (GEMINI_API_KEY is checked as a fallback):
# IRENE__LLM__API_KEY=AIza...
# GEMINI_API_KEY=AIza...

# Live mode (example — only when `irene.mode: live` in yaml):
# IRENE__POLYMARKET__PRIVATE_KEY=
