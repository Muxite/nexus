# ── Seulgi environment variables ──────────────────────────────────────────
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Then start with:
#   docker compose up -d
#
# All SEULGI__SECTION__KEY vars override the matching config.yaml value.

# ── REQUIRED ──────────────────────────────────────────────────────────────

# OpenRouter API key — get one at https://openrouter.ai/keys
# OpenRouter gives access to Gemini, Claude, Llama, and many others.
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# ── AI MODEL (optional) ───────────────────────────────────────────────────
# OpenRouter model IDs — see https://openrouter.ai/models
# Default is google/gemini-2.5-flash (fast and cheap)
# Other good options:
#   google/gemini-2.5-flash-preview-05-20
#   anthropic/claude-haiku-4-5
#   meta-llama/llama-3.1-8b-instruct  (free tier)
# SEULGI__AI__MODEL=google/gemini-2.5-flash

# ── OPTIONAL OVERRIDES ────────────────────────────────────────────────────

# Log verbosity: INFO (default) or DEBUG (verbose Playwright + embed output)
# LOG_LEVEL=INFO

# Starting paper balance
# SEULGI__TRADING__BALANCE_USDC=1000.0

# Max USDC to stake per trade
# SEULGI__TRADING__MAX_POSITION_USDC=100.0

# Minimum edge to execute (lower = more trades, higher = more selective)
# SEULGI__TRADING__MIN_EDGE=0.04

# Close positions held longer than this
# SEULGI__TRADING__POSITION_TIMEOUT_HOURS=24.0

# Minimum AI confidence to trade (0–1)
# SEULGI__AI__MIN_CONFIDENCE=0.45

# Market similarity threshold (lower = more markets matched per headline)
# SEULGI__MARKETS__SIMILARITY_THRESHOLD=0.35

# Markets evaluated per headline
# SEULGI__MARKETS__TOP_K=15

# Dashboard refresh interval (seconds)
# SEULGI__DASHBOARD__INTERVAL_SECS=30.0
